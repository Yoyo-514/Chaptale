{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-types/**"]
    },
    "@chaptale/desktop#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop-ui/src/**",
        "$TURBO_ROOT$/apps/desktop-ui/public/**",
        "$TURBO_ROOT$/apps/desktop-ui/build/**",
        "$TURBO_ROOT$/apps/desktop-ui/index.html",
        "$TURBO_ROOT$/apps/desktop-ui/uno.config.ts",
        "$TURBO_ROOT$/apps/desktop-ui/package.json"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@chaptale/desktop#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/desktop-ui/build/**"],
      "outputs": []
    },
    "@chaptale/shared#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "@chaptale/ipc-contract#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
