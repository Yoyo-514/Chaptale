# Chaptale API model configuration
# Copy this file to .env and fill in your own provider credentials.

# Supported values: openai-chat, openai-responses, anthropic-messages
MODEL_PROVIDER=openai-chat

# Example: gpt-4.1-mini, claude-3-5-sonnet-latest, or a compatible model name.
MODEL=

# OpenAI-compatible or Anthropic API key.
API_KEY=

# Optional for OpenAI-compatible providers.
# Example: https://api.openai.com/v1
BASE_URL=
