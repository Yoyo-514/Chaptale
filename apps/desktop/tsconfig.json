{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist-types",
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    "paths": {
      "@chaptale/ipc-contract": ["../../packages/ipc-contract/src/index.ts"],
      "@chaptale/shared": ["../../packages/shared/src/index.ts"]
    },
    "noEmit": true,
    "erasableSyntaxOnly": false
  },
  "include": ["electron.vite.config.ts", "src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/ipc-contract"
    }
  ]
}
