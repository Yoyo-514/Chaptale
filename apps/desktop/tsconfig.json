{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist-types",
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    "paths": {
      "@chaptale/ipc-contract/channels": ["../../packages/ipc/src/channels.ts"],
      "@chaptale/ipc-contract": ["../../packages/ipc/src/index.ts"],
      "@chaptale/shared": ["../../packages/shared/src/index.ts"]
    },
    "noEmit": true,
    "erasableSyntaxOnly": false
  },
  "include": ["package.json", "vite.config.ts", "src/**/*.ts", "../desktop-ui/build/**/*.ts"],
  "references": [
    {
      "path": "../../packages/shared/tsconfig.json"
    },
    {
      "path": "../../packages/ipc/tsconfig.json"
    }
  ]
}
