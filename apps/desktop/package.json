{
  "name": "@chaptale/desktop",
  "version": "1.5.0",
  "private": true,
  "description": "Chaptale desktop application shell",
  "license": "MIT",
  "author": "yoyo514",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite --config vite.config.ts",
    "build": "cross-env NODE_ENV=production vite build --config vite.config.ts",
    "pack:dir": "pnpm build && electron-builder --dir --config electron-builder.yml",
    "dist": "pnpm build && electron-builder --config electron-builder.yml",
    "dist:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "pnpm build && electron-builder --mac --config electron-builder.yml",
    "dist:linux": "pnpm build && electron-builder --linux --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cd ../.. && vitest run --config vitest.config.ts --project desktop",
    "preview": "pnpm build && cross-env NODE_ENV=production electron ."
  },
  "dependencies": {
    "@chaptale/ipc-contract": "workspace:*",
    "@chaptale/shared": "workspace:*",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@node-rs/jieba": "catalog:",
    "klona": "catalog:",
    "marked": "catalog:",
    "minisearch": "catalog:",
    "pi-web-access": "catalog:",
    "pinyin-pro": "catalog:",
    "radash": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/mingcute": "catalog:",
    "@types/node": "catalog:",
    "@unocss/preset-icons": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "cross-env": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
