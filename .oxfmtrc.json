{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "quoteProps": "as-needed",
  "endOfLine": "lf",
  "sortImports": {
    "customGroups": [
      {
        "groupName": "workspace",
        "elementNamePattern": ["@chaptale/**"]
      },
      {
        "groupName": "app-alias",
        "elementNamePattern": ["@/**"]
      }
    ],
    "groups": [
      ["builtin", "external"],
      "workspace",
      "app-alias",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "node_modules/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "package-lock.json",
    ".env*",
    "LICENSE",
    "LICENCE"
  ]
}
