{
  "name": "chaptale",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "author": "yoyo514",
  "description": "A cross-platform creative writing IDE for novels and scripts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:app": "pnpm --filter @chaptale/app dev",
    "dev:api": "pnpm --filter @chaptale/api dev",
    "build": "pnpm -r --filter @chaptale/shared --filter @chaptale/app --filter @chaptale/api build",
    "build:app": "pnpm --filter @chaptale/app build",
    "build:api": "pnpm --filter @chaptale/api build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prepare": "husky",
    "preview": "pnpm --filter @chaptale/app preview"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,jsonc}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "creative-writing",
    "novel",
    "script",
    "ide",
    "ai"
  ],
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
