{
  "name": "chaptale",
  "version": "1.5.0",
  "private": true,
  "description": "A cross-platform creative writing IDE for novels and scripts",
  "keywords": [
    "ai",
    "creative-writing",
    "ide",
    "novel",
    "script"
  ],
  "license": "MIT",
  "author": "yoyo514",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @chaptale/desktop dev",
    "dev:desktop": "pnpm --filter @chaptale/desktop dev",
    "build": "turbo run build",
    "build:shared": "turbo run build --filter @chaptale/shared",
    "build:desktop": "turbo run build --filter @chaptale/desktop",
    "pack:desktop": "pnpm --filter @chaptale/desktop run pack:dir",
    "dist:desktop": "pnpm --filter @chaptale/desktop run dist",
    "dist:desktop:win": "pnpm --filter @chaptale/desktop run dist:win",
    "dist:desktop:mac": "pnpm --filter @chaptale/desktop run dist:mac",
    "dist:desktop:linux": "pnpm --filter @chaptale/desktop run dist:linux",
    "typecheck": "turbo run typecheck",
    "typecheck:shared": "turbo run typecheck --filter @chaptale/shared",
    "typecheck:desktop": "turbo run typecheck --filter @chaptale/desktop",
    "check": "run-s lint typecheck test",
    "test": "run-s test:unit test:e2e",
    "test:unit": "turbo run test",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "run-s test:e2e:renderer test:e2e:electron",
    "test:e2e:renderer": "playwright test --config playwright.config.ts",
    "test:e2e:electron": "pnpm build:desktop && playwright test --config playwright.electron.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prepare": "husky",
    "preview": "pnpm --filter @chaptale/desktop preview",
    "preview:desktop": "pnpm --filter @chaptale/desktop preview"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,jsonc,vue}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.0"
}
