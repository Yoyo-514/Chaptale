{
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "node_modules/**",
    "coverage/**",
    "*.config.js",
    "*.config.mjs",
    "*.config.ts",
    "pnpm-lock.yaml",
    "package-lock.json"
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "no-await-in-loop": "off",
    "eslint/no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-extraneous-class": [
      "error",
      {
        "allowWithDecorator": true
      }
    ],
    "unicorn/require-module-specifiers": "allow"
  }
}
