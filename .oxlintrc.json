{
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "node_modules/**",
    "coverage/**",
    "*.config.js",
    "*.config.mjs",
    "*.config.ts",
    "pnpm-lock.yaml",
    "package-lock.json"
  ],
  "overrides": [
    {
      "files": ["packages/creation/src/**/*.ts", "packages/agent-host/src/**/*.ts"],
      "rules": {
        "import/no-cycle": ["error", { "ignoreExternal": true, "ignoreTypes": false }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "electron",
              "electron/**",
              "vue",
              "vue/**",
              "@chaptale/desktop*",
              "@chaptale/desktop*/**",
              "**/apps/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/creation/src/{service,drafts,repository,errors,index}.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "electron",
              "vue",
              "@chaptale/desktop*",
              "**/apps/**",
              "better-sqlite3",
              "./storage/**",
              "@chaptale/creation/storage",
              "@chaptale/agent-host*",
              "@chaptale/agent-host/**",
              "@earendil-works/**"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/creation/src/contracts.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "node:*",
              "node:*/**",
              "electron",
              "vue",
              "better-sqlite3",
              "@chaptale/desktop*",
              "**/apps/**",
              "@chaptale/agent-host*",
              "@chaptale/agent-host/**",
              "@earendil-works/**",
              "./service*",
              "./drafts*",
              "./errors*",
              "./repository*",
              "./storage/**"
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "no-await-in-loop": "off",
    "eslint/no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-extraneous-class": [
      "error",
      {
        "allowWithDecorator": true
      }
    ]
  }
}
