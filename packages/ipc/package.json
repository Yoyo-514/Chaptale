{
  "name": "@chaptale/ipc-contract",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "default": "./src/channels.ts"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "test": "cd ../.. && vitest run --config vitest.config.ts --project ipc",
    "typecheck": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json"
  },
  "dependencies": {
    "@chaptale/shared": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
