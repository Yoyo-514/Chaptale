{
  "name": "@chaptale/creation",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./src/contracts.ts"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "default": "./src/application.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@chaptale/contracts": "workspace:*",
    "@chaptale/shared": "workspace:*",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
