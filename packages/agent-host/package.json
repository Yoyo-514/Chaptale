{
  "name": "@chaptale/agent-host",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./src/protocol.ts"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "default": "./src/application/index.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "cd ../.. && vitest run --config vitest.config.ts --project agent-host",
    "test:live": "node scripts/verify-live-session.mjs",
    "test:live:host": "node scripts/verify-live-session.mjs --host",
    "test:live:electron": "node scripts/verify-live-session.mjs --electron-host"
  },
  "dependencies": {
    "@chaptale/contracts": "workspace:*",
    "@chaptale/creation": "workspace:*",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-mcp": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@types/node": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
