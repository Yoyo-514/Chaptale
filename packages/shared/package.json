{
  "name": "@chaptale/shared",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./document-frontmatter": {
      "types": "./dist/document-frontmatter.d.ts",
      "default": "./src/document-frontmatter.ts"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "typecheck": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.json",
    "test": "cd ../.. && vitest run --config vitest.config.ts --project shared"
  },
  "dependencies": {
    "typebox": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
